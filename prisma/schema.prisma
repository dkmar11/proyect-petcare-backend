generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets          Pet[]
  notifications Notification[]
}

model Pet {
  id                  String   @id @default(uuid())
  name                String
  species             String
  breed               String?
  dateOfBirth         DateTime?
  specialHandlingNote String?
  vaccinationRecord   String?
  ownerId             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])
}

model Provider {
  id             String   @id @default(uuid())
  displayName    String
  providerType   String
  city           String
  email          String?  @unique
  password       String?
  supportsPickup Boolean  @default(false)
  supportsHome   Boolean  @default(false)
  branchId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers Provider[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  bookingId String?
  type      String
  title     String
  message   String
  channel   String   @default("IN_APP")
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
